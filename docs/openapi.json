{
  "openapi": "3.0.3",
  "info": {
    "title": "卡密认证系统 — 客户端 API",
    "description": "客户端卡密认证 SDK 集成契约。所有接口均为 POST，请求体使用大写首字母字段名（Softid, Card, Mac, Version, Token），响应为 JSON。",
    "version": "1.3.0",
    "contact": { "name": "AuthSystem", "url": "https://github.com/auth-system" }
  },
  "servers": [
    { "url": "https://{host}", "description": "生产环境", "variables": { "host": { "default": "api.example.com" } } },
    { "url": "http://localhost:3000", "description": "本地开发" }
  ],
  "tags": [
    { "name": "card", "description": "卡密认证与会话管理" },
    { "name": "app", "description": "应用信息查询" }
  ],
  "components": {
    "schemas": {
      "Softid": {
        "type": "string",
        "pattern": "^[A-Za-z0-9]{18}$",
        "description": "18 位字母数字软件标识",
        "example": "AbcDef123GhiJklMn"
      },
      "Card": {
        "type": "string",
        "description": "卡密明文",
        "example": "XXXX-XXXX-XXXX-XXXX"
      },
      "Mac": {
        "type": "string",
        "description": "机器码 / 设备标识",
        "example": "AA-BB-CC-DD-EE-FF"
      },
      "Version": {
        "type": "string",
        "description": "客户端版本号（SemVer）",
        "example": "1.2.0"
      },
      "Token": {
        "type": "string",
        "description": "登录成功后返回的会话 Token（16 位）",
        "example": "aB3xY9kLm2NpQ7Rz"
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "errcode": {
            "type": "string",
            "description": "错误码，见错误码对照表",
            "example": "-1004"
          }
        },
        "required": ["errcode"]
      },
      "LoginRequest": {
        "type": "object",
        "required": ["Softid", "Card", "Mac"],
        "properties": {
          "Softid": { "$ref": "#/components/schemas/Softid" },
          "Card": { "$ref": "#/components/schemas/Card" },
          "Mac": { "$ref": "#/components/schemas/Mac" },
          "Version": { "$ref": "#/components/schemas/Version" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": { "$ref": "#/components/schemas/Token" },
          "license": {
            "type": "object",
            "nullable": true,
            "description": "离线授权凭证（Ed25519 签名），客户端可离线验证",
            "properties": {
              "license_id": { "type": "string" },
              "app_id": { "type": "integer" },
              "device_id": { "type": "string" },
              "features": { "type": "array", "items": { "type": "string" } },
              "issued_at": { "type": "string", "format": "date-time" },
              "expires_at": { "type": "string", "format": "date-time", "nullable": true },
              "signature": { "type": "string", "description": "Ed25519 签名（Base64）" },
              "public_key": { "type": "string", "description": "签发公钥标识" }
            }
          }
        }
      },
      "HeartbeatRequest": {
        "type": "object",
        "required": ["Softid", "Card", "Token"],
        "properties": {
          "Softid": { "$ref": "#/components/schemas/Softid" },
          "Card": { "$ref": "#/components/schemas/Card" },
          "Token": { "$ref": "#/components/schemas/Token" }
        }
      },
      "LogoutRequest": {
        "type": "object",
        "required": ["Softid", "Card", "Token"],
        "properties": {
          "Softid": { "$ref": "#/components/schemas/Softid" },
          "Card": { "$ref": "#/components/schemas/Card" },
          "Token": { "$ref": "#/components/schemas/Token" }
        }
      },
      "ExpiryRequest": {
        "type": "object",
        "required": ["Softid", "Card", "Token"],
        "properties": {
          "Softid": { "$ref": "#/components/schemas/Softid" },
          "Card": { "$ref": "#/components/schemas/Card" },
          "Token": { "$ref": "#/components/schemas/Token" }
        }
      },
      "ExpiryResponse": {
        "type": "object",
        "properties": {
          "expires_at": {
            "type": "string",
            "description": "到期时间 YYYY-MM-DD HH:mm:ss",
            "example": "2025-12-31 23:59:59"
          }
        }
      },
      "SimpleRequest": {
        "type": "object",
        "required": ["Softid"],
        "properties": {
          "Softid": { "$ref": "#/components/schemas/Softid" }
        }
      },
      "VersionResponse": {
        "type": "object",
        "properties": {
          "version": { "$ref": "#/components/schemas/Version" }
        }
      },
      "UrlResponse": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "format": "uri" }
        }
      },
      "ResultResponse": {
        "type": "object",
        "properties": {
          "result": { "type": "string", "example": "1" }
        }
      }
    }
  },
  "paths": {
    "/announcement": {
      "post": {
        "tags": ["app"],
        "summary": "获取公告",
        "description": "返回纯文本公告内容",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SimpleRequest" } } }
        },
        "responses": {
          "200": { "description": "公告文本", "content": { "text/plain": { "schema": { "type": "string" } } } }
        }
      }
    },
    "/version": {
      "post": {
        "tags": ["app"],
        "summary": "获取最新版本号",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SimpleRequest" } } }
        },
        "responses": {
          "200": {
            "description": "版本信息",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VersionResponse" } } }
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": ["card"],
        "summary": "卡密登录",
        "description": "首次激活或再次登录，返回会话 Token 和离线授权凭证",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } } }
          },
          "400": {
            "description": "参数缺失或格式错误",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "403": {
            "description": "卡密不存在 / 已禁用 / 已过期 / 机器码不匹配 / 已在其他设备登录 / 需强制更新 / 配额已满",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/logout": {
      "post": {
        "tags": ["card"],
        "summary": "卡密登出",
        "description": "清除当前会话 Token",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LogoutRequest" } } }
        },
        "responses": {
          "200": {
            "description": "登出成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultResponse" } } }
          },
          "400": {
            "description": "参数缺失或 Token 无效",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/heartbeat": {
      "post": {
        "tags": ["card"],
        "summary": "心跳保活",
        "description": "校验会话有效性并将 Token 有效期延长 24 小时",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HeartbeatRequest" } } }
        },
        "responses": {
          "200": {
            "description": "心跳成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResultResponse" } } }
          },
          "400": {
            "description": "会话无效或卡密已过期",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/expiry": {
      "post": {
        "tags": ["card"],
        "summary": "获取到期时间",
        "description": "需携带登录返回的 Token",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExpiryRequest" } } }
        },
        "responses": {
          "200": {
            "description": "到期时间",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExpiryResponse" } } }
          },
          "400": {
            "description": "参数缺失或 Token 无效",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/download": {
      "post": {
        "tags": ["app"],
        "summary": "获取下载地址",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SimpleRequest" } } }
        },
        "responses": {
          "200": {
            "description": "下载地址",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UrlResponse" } } }
          }
        }
      }
    },
    "/usage": {
      "post": {
        "tags": ["app"],
        "summary": "获取使用说明",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SimpleRequest" } } }
        },
        "responses": {
          "200": {
            "description": "使用说明地址",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UrlResponse" } } }
          }
        }
      }
    },
    "/purchase": {
      "post": {
        "tags": ["app"],
        "summary": "获取购买地址",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SimpleRequest" } } }
        },
        "responses": {
          "200": {
            "description": "购买地址",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UrlResponse" } } }
          }
        }
      }
    }
  }
}
