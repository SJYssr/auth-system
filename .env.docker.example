# Docker 部署环境变量模板：cp .env.docker.example .env 后按需修改
# 对外端口
PORT=3000

# 数据库凭据（务必修改默认密码！）
DB_NAME=auth-system
DB_USER=auth_admin
DB_PASSWORD=change_db_password
MYSQL_ROOT_PASSWORD=change_root_password

# 可选：额外允许跨域的来源（逗号分隔），服务启动时会自动探测公网 IP 并加入白名单
# CORS_ORIGINS=https://your-domain.com

# 可选：信任的反向代理层数（默认 1，适配单层反代；容器直接对外时设为 false）
# TRUST_PROXY=1

# 可选：SMTP 邮件服务（三项同时配置后启用「管理员账号到期邮件提醒」）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=no-reply@example.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM=no-reply@example.com
# SMTP_SECURE=true
# ADMIN_EXPIRY_REMIND_DAYS=7
