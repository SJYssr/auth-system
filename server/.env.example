PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=auth_admin
DB_PASSWORD=your_password
DB_NAME=auth-system

# 可选：额外允许跨域的来源（逗号分隔），服务启动时会自动探测公网 IP 并加入白名单
# CORS_ORIGINS=https://your-domain.com

# 可选：信任的反向代理层数（获取真实客户端 IP 用）。默认 1，适配单层 OpenResty/Nginx 反代；
# 进程直接暴露公网时务必设为 false，否则可被伪造 X-Forwarded-For 绕过按 IP 限流。
# 也支持代理层数字、'true' 或 IP/网段列表（如 loopback,10.0.0.0/8）
# TRUST_PROXY=1

# ===== 卡密加密 Pepper（生产环境必须配置）=====
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CARD_PEPPER=

# ===== 离线授权签名密钥（Ed25519，生产环境必须配置）=====
# 生成方式: node -e "const k=require('crypto').generateKeyPairSync('ed25519');console.log(k.privateKey.export({type:'pkcs8',format:'der'}).toString('hex'))"
LICENSE_SIGNING_KEY=

# ===== Redis 缓存（可选，未配置时走 MySQL 回退）=====
# REDIS_URL=redis://localhost:6379

# ===== 自动数据库备份（可选）=====
# BACKUP_ENABLED=true
# BACKUP_PATH=/data/backups
# BACKUP_RETENTION_DAYS=7

# ===== Webhook SSRF 防护 =====
# WEBHOOK_ALLOW_HTTP=false
# WEBHOOK_DOMAIN_ALLOWLIST=example.com,api.example.com

# ===== 初始管理员配置（首次启动时创建，admins 表为空时生效）=====
# Docker / CI 部署推荐用环境变量注入，密码为空则拒绝启动。
# 也可通过 /api/setup 引导页手动创建（需设置 DATABASE_URL 直连）。
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=admin@example.com

# 可选：SMTP 邮件服务（三项同时配置后启用「管理员账号到期邮件提醒」）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=no-reply@example.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM=no-reply@example.com     # 发件人，留空用 SMTP_USER
# SMTP_SECURE=true                   # 留空按端口判断（465 为 true）
# ADMIN_EXPIRY_REMIND_DAYS=7         # 到期前 N 天开始提醒（默认 7，同一账号每 24 小时最多一次）
